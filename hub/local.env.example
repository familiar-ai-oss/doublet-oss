# Copy to local.env (git-ignored) and fill in. Variables set in the environment take precedence.

# Tailscale logins allowed through `tailscale serve`, comma-separated (e.g. you@github). Empty: only loopback.
DUET_ALLOWED_LOGINS=
# Live Activity pushes: your Apple team id and the app's bundle id (or set them in ~/.config/duet/apns.json).
DUET_APNS_TEAM_ID=
DUET_APNS_BUNDLE=
# The name shown for this hub on the Lock Screen. Default: the machine's hostname.
DUET_HUB_NAME=
# llmd, an optional model server that swaps models on your GPUs: its admin URL, its models.toml (which GPU each model
# lives on), and the models that take every GPU when loaded (comma-separated). Leave empty without llmd.
DUET_LLMD_ADMIN=
DUET_MODELS_TOML=
DUET_LLMD_CLAIMS_ALL=
# Your model server for workers: Ollama's address (here, on another machine, or over the tailnet) and the model to use.
# Empty: this machine's Ollama with qwen3:8b. For several workers, use a fleet file instead (fleet.example.json).
DUET_OLLAMA_URL=
DUET_OLLAMA_MODEL=
# Which Claude Code the hub runs: by default the `claude` on PATH (or in ~/.local/bin), signed in however you chose.
DUET_CLAUDE_PATH=
# Optional guard on your own hub: `subscription` runs Claude only on a Claude plan's login (never an API key in the
# environment), `max` only on a Max plan. Empty: whatever Claude Code is signed in with.
DUET_LEAD_AUTH=
